# --- Neon Postgres (required) ---
# Copy your Neon connection string here (Dashboard -> Connection Details -> "Pooled connection").
# It looks like: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Session signing secret (required) ---
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Analytics: Mixpanel (optional) ---
# Add your Mixpanel project token to send events. Without it, events are wired
# but no-op (and log to the browser console in dev).
NEXT_PUBLIC_MIXPANEL_TOKEN=

# --- AI tutor (optional) ---
# If set, the tutor uses a real LLM. If left blank, Querly falls back to curated, hand-written hints
# so the app works fully on free hosting with no AI bill.
ANTHROPIC_API_KEY=
# Model id used when ANTHROPIC_API_KEY is present.
TUTOR_MODEL=claude-haiku-4-5-20251001
